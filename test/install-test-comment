#!/bin/bash
#
# Writes the install test's comment for a pull request: one table, a row per
# measurement, the same rows for every architecture, next to quattro's numbers.
#
#   test/install-test-comment <pr_artifacts> <quattro_artifacts> <conclusion> <run_url> <head_sha>
#
# Each directory holds one folder per artifact of an "Install test" run, named
# install-test-<run>-<attempt>-<arch>. The artifacts are read as data only.
set -euo pipefail
pr=$1 base=$2 conclusion=$3 run_url=$4 head_sha=$5

# An artifact from before the test ran on two architectures has no suffix.
arch_of() { case $1 in *-aarch64) echo aarch64 ;; *) echo x86_64 ;; esac; }
# architecture, artifacts -> that architecture's folder, or nothing
folder() {
  local d
  for d in "$2"/*/; do
    [[ -d $d && $(arch_of "$(basename "$d")") == "$1" ]] && { echo "${d%/}"; return; }
  done
  true
}

# Shared exact decimal reader and formatter (half-away-from-zero to tenths) so
# summary cells, summary deltas, and phase rows agree on every boundary input
# and untrusted timing JSON never passes through shell delimiters.
py_timing() {
  python3 - "$@" <<'PY'
import json
import re
import sys
from decimal import Decimal, ROUND_HALF_UP

Q = Decimal("0.1")


def fmt_cell(val: Decimal | None) -> str:
    if val is None:
        return "–"
    v = val.quantize(Q, rounding=ROUND_HALF_UP)
    if v == 0:
        v = Decimal("0.0")
    return f"{v:.1f} s"


def fmt_delta(this: Decimal | None, was: Decimal | None, thresh: Decimal) -> str:
    if this is None or was is None:
        return "–"
    d = (this - was).quantize(Q, rounding=ROUND_HALF_UP)
    if d == 0:
        d = Decimal("0.0")
    s = f"{'+' if d >= 0 else '−'}{abs(d):.1f} s"
    if d >= thresh:
        return f"🔴 **{s}**"
    if d <= -thresh:
        return f"🟢 {s}"
    return s


def load_json(path: str):
    with open(path, encoding="utf-8") as fh:
        return json.load(fh, parse_float=Decimal, parse_int=Decimal)


def require_num(val, *, allow_none: bool = False) -> Decimal | None:
    if val is None and allow_none:
        return None
    if not isinstance(val, Decimal) or not val.is_finite():
        raise ValueError(f"expected finite number, got {type(val).__name__}")
    return val


mode = sys.argv[1]
if mode == "cell":
    print(fmt_cell(Decimal(sys.argv[2])))
elif mode == "delta":
    print(fmt_delta(Decimal(sys.argv[2]), Decimal(sys.argv[3]), Decimal(sys.argv[4])))
elif mode == "install":
    try:
        data = load_json(sys.argv[2])
        if isinstance(data, dict):
            s = require_num(data.get("started_at"))
            e = require_num(data.get("finished_at"))
            print(e - s)
    except (OSError, ValueError):
        pass
elif mode == "phases":
    pt_path, bt_path = sys.argv[2], sys.argv[3]
    pr_data = load_json(pt_path)
    if not isinstance(pr_data, dict) or not isinstance(pr_data.get("phases"), list):
        raise ValueError("timing JSON missing phases list")
    base_map: dict[str, Decimal | None] = {}
    if bt_path:
        base_data = load_json(bt_path)
        if not isinstance(base_data, dict) or not isinstance(base_data.get("phases"), list):
            raise ValueError("baseline timing JSON missing phases list")
        for item in base_data["phases"]:
            if not isinstance(item, dict) or not isinstance(item.get("name"), str):
                raise ValueError("invalid baseline phase entry")
            base_map[item["name"]] = require_num(item.get("elapsed"), allow_none=True)
    thresh = Decimal("0.5")
    for item in pr_data["phases"]:
        if not isinstance(item, dict) or not isinstance(item.get("name"), str):
            raise ValueError("invalid phase entry")
        raw_name = item["name"]
        # Phase names come from the pull request's installer: keep them to plain text.
        name = re.sub(r"[^A-Za-z0-9 +&/().-]", "", raw_name)[:60]
        this = require_num(item.get("elapsed"), allow_none=True)
        was = base_map.get(raw_name)
        print(f"| {name} | {fmt_cell(this)} | {fmt_cell(was)} | {fmt_delta(this, was, thresh)} |")
PY
}

# Every lookup prints nothing rather than failing, so a missing number (no
# baseline yet, or a test that stopped early) shows as "–".
first() { [[ -n $1 ]] || return 0; { find "$1" -path "$2" 2>/dev/null || true; } | sort | head -1; }
build_s() { local f; f=$(first "$1" '*/build-seconds'); [[ -z $f ]] || tr -dc 0-9. <"$f"; }
install_s() { local f; f=$(first "$1" '*/omarchy-install-timing.json'); [[ -z $f ]] || py_timing install "$f"; }
# "Startup finished in 2s (firmware) + 9s (loader) + 1min 3.2s (userspace) = …"
# -> seconds, without the firmware's share: it is the VM's, and in the aarch64
# VM it reads as the runner's uptime, minutes long.
boot_s() {
  local f; f=$(first "$1" "$2"); [[ -n $f ]] || return 0
  head -1 "$f" | sed -e 's/.*finished in //' -e 's/ *=.*//' | tr '+' '\n' | grep -v firmware |
    awk '{for (i = 1; i <= NF; i++) { if ($i ~ /^\(/) continue; n++
           if ($i ~ /min$/) t += 60 * $i; else if ($i ~ /ms$/) t += $i / 1000; else t += $i }}
         END {if (n) printf "%.3f", t}'
}
first_boot_s() { boot_s "$1" '*/first-boot-systemd-analyze.txt'; }
everyday_boot_s() { boot_s "$1" '*-boot/systemd-analyze.txt'; }
cell() { [[ -n $1 ]] && py_timing cell "$1" || echo "–"; }
change() { [[ -n $1 && -n $2 ]] && py_timing delta "$1" "$2" "$3" || echo "–"; }
result() {
  case $(cat "$1/status" 2>/dev/null || true) in
  success) echo "✅ passed" ;; "") echo "–" ;; *) echo "❌ $(cat "$1/status")" ;;
  esac
}

arches=()
for arch in x86_64 aarch64; do [[ -z $(folder "$arch" "$pr") ]] || arches+=("$arch"); done

status="passed"; [[ $conclusion == success ]] || status="**$conclusion**"
echo '<!-- omarchy-install-test -->'
echo "### Install test $status"
echo
head="| |" rule="| --- |" results="| Result |"
for arch in "${arches[@]}"; do
  head+=" \`$arch\` | vs quattro |" rule+=" ---: | ---: |" results+=" $(result "$(folder "$arch" "$pr")") | |"
done
printf '%s\n' "$head" "$rule" "$results"
for row in \
  "Build the ISO|build_s|10.0" \
  "Install|install_s|1.0" \
  "First boot|first_boot_s|0.5" \
  "Everyday boot|everyday_boot_s|0.5"; do
  IFS='|' read -r label fn thresh <<<"$row"
  line="| $label |"
  for arch in "${arches[@]}"; do
    this=$("$fn" "$(folder "$arch" "$pr")") was=$("$fn" "$(folder "$arch" "$base")")
    line+=" $(cell "$this") | $(change "$this" "$was" "$thresh") |"
  done
  echo "$line"
done
echo
echo "Boots are loader, kernel and userspace, without the VM's firmware."
for arch in "${arches[@]}"; do
  pt=$(first "$(folder "$arch" "$pr")" '*/omarchy-install-timing.json')
  bt=$(first "$(folder "$arch" "$base")" '*/omarchy-install-timing.json')
  [[ -s $pt ]] || continue
  [[ -s $bt ]] || bt=""
  echo
  echo "<details><summary>Install phases, $arch</summary>"
  echo
  echo "| Phase | This PR | quattro | vs quattro |"
  echo "| --- | ---: | ---: | ---: |"
  py_timing phases "$pt" "$bt"
  echo
  echo "</details>"
done
echo
echo "[Run]($run_url) · ${head_sha:0:8}"
